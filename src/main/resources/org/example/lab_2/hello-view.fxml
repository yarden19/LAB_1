<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="392.0" prefWidth="277.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.lab_2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <TextField fx:id="gmailText" prefHeight="38.0" prefWidth="199.0" promptText="enter username(gmail)" />
    <TextField fx:id="passwordText" promptText="enter password" />
    <Button fx:id="CheckData" onAction="#onLogInClick" text="Log in!" />
</VBox>
